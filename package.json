{
  "name": "lexprompt-enterprise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "hosting:off": "npx firebase-tools@13 hosting:disable",
    "hosting:on": "npm run build && npx firebase-tools@13 deploy",
    "gateway:dev": "npm run dev -w @lexprompt/gateway",
    "api:dev": "npm run dev -w @lexprompt/api",
    "typecheck": "node scripts/typecheck.mjs",
    "compose:up": "docker compose up -d --build && bash scripts/print-local-accounts.sh",
    "compose:down": "docker compose down -v",
    "test:compose": "vitest run --config vitest.compose.config.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts"
  },
  "dependencies": {
    "@lexprompt/core": "*",
    "docx": "^9.7.1",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "mammoth": "^1.12.1",
    "oidc-client-ts": "^3.5.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
