GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend Supabase (API routes / server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Supabase Auth (magic link)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_DEMO_AUTH=false
# Server-side only. Keep false in hosted beta.
ALLOW_INSECURE_DEMO_AUTH=false
# Optional private-beta allowlists (comma-separated).
BETA_ALLOWED_EMAILS=
BETA_ALLOWED_DOMAINS=
# platform | byok | hybrid
# platform: use server-managed keys only
# byok: users must provide personal keys in Engine Settings
# hybrid: allow either (default)
VITE_KEY_POLICY=platform

# Frontend runtime
VITE_AI_PROXY_URL=/api/ai/generate
# auto | true | false
VITE_USE_AI_PROXY=true
# auto | true | false
VITE_USE_COLLAB_API=true
# Must remain false in hosted beta.
VITE_ALLOW_CLIENT_SIDE_AI=false
