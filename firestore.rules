rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection: Only the user can access their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Templates Collection
    match /templates/{templateId} {
      // Allow create if auth matches the userId field
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow read/update/delete if the existing document belongs to the user
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow reading 'team' scopes if authenticated (Basic team logic)
      allow read: if isAuthenticated() && resource.data.scope == 'team';
    }
  }
}
